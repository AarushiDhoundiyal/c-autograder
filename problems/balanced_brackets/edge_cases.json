{
  "description": "Corner cases for balanced_brackets. Wrong nesting, unclosed brackets, other characters and deep nesting. Expected outputs come from reference.c, never from an LLM.",
  "groups": {
    "empty": [
      "",
      "\n"
    ],
    "simple": [
      "()\n",
      "[]{}\n",
      "{[()]}\n"
    ],
    "wrong_order": [
      "([)]\n",
      "{(})\n"
    ],
    "unclosed": [
      "((\n",
      "{[\n",
      "(()\n"
    ],
    "unopened": [
      ")(\n",
      "())\n",
      "]\n"
    ],
    "other_text": [
      "if (a[i] > 0) { b = f(a); }\n",
      "no brackets here\n"
    ],
    "deep_nesting": [
      "(((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((())))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))\n",
      "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]\n"
    ],
    "crlf": [
      "(\r\n)\r\n"
    ],
    "no_trailing_newline": [
      "{}"
    ]
  }
}
