{
  "problem": "add_two_integers",
  "description": "Full nine-metric rule set. Weights sum to 1.00. Edit freely; no code change needed.",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "skipped_policy": "zero",
  "smoke_input": "7 5\n",
  "metrics": [
    {"name": "correctness", "analyzer": "io_tests", "weight": 0.20,
     "params": {"testset_dir": "problems/add/tests", "compare": "tokens"}},
    {"name": "syntax", "analyzer": "compiler_warnings", "weight": 0.10,
     "params": {"flags": "-Wall -Wextra -std=c11", "penalty_per_warning": 0.1}},
    {"name": "structure", "analyzer": "static_analysis", "weight": 0.10,
     "params": {"max_cyclomatic": 8, "max_function_length": 40}},
    {"name": "modularity", "analyzer": "function_split", "weight": 0.10,
     "params": {"expect_helpers": true, "min_functions": 2}},
    {"name": "logical", "analyzer": "edge_case_runner", "weight": 0.10,
     "params": {"reference": "problems/add/reference.c",
                "edge_cases_file": "problems/add/edge_cases.json",
                "cases": ["negatives", "zero", "int_overflow", "whitespace"]}},
    {"name": "complexity", "analyzer": "complexity_estimator", "weight": 0.10,
     "params": {"required": "O(1)", "sizes": [1, 10, 100]}},
    {"name": "memory_safety", "analyzer": "sanitizer_run", "weight": 0.10,
     "params": {"testset_dir": "problems/add/tests",
                "flags": "-fsanitize=address,undefined -g -O0"}},
    {"name": "readability", "analyzer": "llm_review", "weight": 0.10,
     "params": {"backend": "ollama", "model": "qwen2.5-coder:7b", "temperature": 0,
                "seed": 42, "cache_dir": ".cache/llm", "llm_share": 0.4}},
    {"name": "originality", "analyzer": "similarity_flag", "weight": 0.10,
     "params": {"corpus_dir": "corpus/", "flag_threshold": 0.85, "min_tokens": 30}}
  ]
}
