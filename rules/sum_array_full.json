{
  "problem": "sum_array",
  "description": "Second problem, nine metrics, different thresholds: shows rules change without code change.",
  "time_limit_s": 2,
  "memory_limit_mb": 128,
  "skipped_policy": "zero",
  "smoke_input": "3\n1 2 3\n",
  "metrics": [
    {"name": "correctness", "analyzer": "io_tests", "weight": 0.25,
     "params": {"testset_dir": "problems/sum_array/tests", "compare": "tokens"}},
    {"name": "syntax", "analyzer": "compiler_warnings", "weight": 0.05,
     "params": {"flags": "-Wall -Wextra -std=c11", "penalty_per_warning": 0.1}},
    {"name": "structure", "analyzer": "static_analysis", "weight": 0.10,
     "params": {"max_cyclomatic": 6, "max_function_length": 30}},
    {"name": "modularity", "analyzer": "function_split", "weight": 0.05,
     "params": {"expect_helpers": false, "min_functions": 1}},
    {"name": "logical", "analyzer": "edge_case_runner", "weight": 0.20,
     "params": {"reference": "problems/sum_array/reference.c",
                "edge_cases_file": "problems/sum_array/edge_cases.json"}},
    {"name": "complexity", "analyzer": "complexity_estimator", "weight": 0.15,
     "params": {"required": "O(n)", "generator": "array", "sizes": [1000, 2000, 4000, 8000]}},
    {"name": "memory_safety", "analyzer": "sanitizer_run", "weight": 0.10,
     "params": {"testset_dir": "problems/sum_array/tests",
                "flags": "-fsanitize=address,undefined -g -O0"}},
    {"name": "readability", "analyzer": "llm_review", "weight": 0.05,
     "params": {"backend": "ollama", "model": "qwen2.5-coder:7b", "temperature": 0,
                "seed": 42, "cache_dir": ".cache/llm", "llm_share": 0.4}},
    {"name": "originality", "analyzer": "similarity_flag", "weight": 0.05,
     "params": {"corpus_dir": "corpus/", "flag_threshold": 0.85, "min_tokens": 40}}
  ]
}
